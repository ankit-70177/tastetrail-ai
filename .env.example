# ==============================================================================
# ENVIRONMENT TEMPLATE — HACKATHON-AUTOPILOT
# 
# INSTRUCTIONS:
# 1. Copy this file to `.env` in your project root: `cp ENV.template .env`
# 2. Fill in the values for the services used in your hackathon.
# 3. NEVER commit `.env` to Git! It is strictly ignored in `.gitignore`.
# ==============================================================================

# --- Application Configuration ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000/api

# --- Offline / Mock Mode (For Local Testing Without API Keys) ---
MOCK_AI=false

# --- AI & Large Language Model Providers ---
# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Groq (Ultra-fast inference)
GROQ_API_KEY=your_groq_api_key_here

# Nebius AI Studio
NEBIUS_API_KEY=your_nebius_api_key_here

# Hugging Face
HF_TOKEN=your_hugging_face_token_here

# Cohere
COHERE_API_KEY=your_cohere_api_key_here

# --- Database & Storage ---
# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Neon / PostgreSQL
DATABASE_URL=postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# SQLite (Local file-based)
SQLITE_DB_PATH=./data/app.db

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# --- Authentication ---
AUTH_SECRET=generate_a_random_32_character_string_here
NEXTAUTH_URL=http://localhost:3000

# --- Cloud & Deployment Services ---
VERCEL_TOKEN=your_vercel_token_here
RENDER_API_KEY=your_render_api_key_here
