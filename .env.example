# ==============================================================================
# TASTETRAIL AI — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in this directory:
#      cp .env.example .env
# 2. Add your QLOO_API_KEY from the Qloo Hackathon developer portal:
#      QLOO_API_KEY=your_actual_key_here
# 3. NEVER commit `.env` to Git! It is strictly excluded by .gitignore.
# ==============================================================================

# --- Application Server ---
NODE_ENV=development
PORT=3000

# --- Qloo Cultural Intelligence API (Official Hackathon Endpoint) ---
# Base URL for the official Qloo hackathon API instance
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Your official Qloo API Key (passed via X-Api-Key header)
# When set, TasteTrail AI runs in LIVE QLOO MODE.
# When empty or omitted, TasteTrail AI runs seamlessly in DEMO FIXTURE MODE
# with authentic Qloo-schema fixtures without failing.
QLOO_API_KEY=

# API request timeout in milliseconds (default: 10000ms / 10s)
QLOO_TIMEOUT_MS=10000

# --- Execution Mode Override ---
# Set to 'true' to force offline demo fixtures even if QLOO_API_KEY is configured
MOCK_AI=false
