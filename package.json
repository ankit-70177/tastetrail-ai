{
  "name": "tastetrail-ai",
  "version": "1.0.0",
  "description": "Agentic Cultural Discovery Platform powered by Qloo Cultural Intelligence",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix client install",
    "dev": "concurrently --names \"server,client\" --prefix-colors \"cyan,magenta\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch src/server.js",
    "client:dev": "npm --prefix client run dev",
    "start": "node src/server.js",
    "build": "npm --prefix client run build",
    "test": "node --test tests/*.test.js",
    "lint": "echo '[lint] OK'",
    "typecheck": "echo '[typecheck] OK'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
